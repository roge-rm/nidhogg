+#ifdef NIDHOGG_HOST
+        // Where playback is, 0-1 through the whole sample, for nidhogg's
+        // screen. A streamed file is ahead of the sound by what's buffered.
+        float HostPosition()
+        {
+            if(using_ram)
+            {
+                const size_t size = ram_buff.GetSize();
+                return size ? float(ram_buff.GetReadHead()) / size : 0.f;
+            }
+            const float head = sizeof(WAV_FormatTypeDef);
+            const float size = float(f_size(&fptr_read)) - head;
+            if(size <= 0.f)
+                return 0.f;
+            const float buffered = 2.f * read_samps.GetNumElements();
+            const float pos = float(f_tell(&fptr_read)) + (reverse_ ? buffered : -buffered) - head;
+            return pos < 0.f ? 0.f : (pos > size ? 1.f : pos / size);
+        }
+#endif
