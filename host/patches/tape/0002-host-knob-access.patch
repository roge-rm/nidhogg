+int nidhogg_input_source() { return int(engine.GetInputSource()); }
+bool nidhogg_fx_pre_looper() { return engine.GetFxPreLooper(); }
+int nidhogg_monitor_mode() { return int(engine.GetMonitorMode()); }
+// 0 empty, 1 armed, 2 first recording, 3 overdubbing, 4 playing, 5 paused
+int nidhogg_looper_state()
+{
+    if(engine.IsLooperRecordArmed())
+        return 1;
+    if(engine.IsLooperFirstRecording() && engine.IsLooperRecording())
+        return 2;
+    if(engine.GetLooperIsEmpty())
+        return 0;
+    if(engine.IsLooperRecording())
+        return 3;
+    return engine.IsLooperPlaying() ? 4 : 5;
+}
