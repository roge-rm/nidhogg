 using namespace daisy;
 using namespace chompi;
@@ -104,11 +112,19 @@
 
 void ZeroSDRAM()
 {
+#ifdef NIDHOGG_HOST
+    // Zeroing the big buffers also maps their memory now, at boot, so audio
+    // never waits on the first touch of a page.
+    std::memset(del_mem, 0, sizeof(del_mem));
+    std::memset(loop_mem, 0, sizeof(loop_mem));
+    std::memset(chompi_mem, 0, sizeof(chompi_mem));
+#else
     uint32_t *beg, *end;
     size_t    size_in_words = (1024 * 1024 * 64) / sizeof(uint32_t);
     beg                     = (uint32_t*)0xc0000000;
     end                     = (uint32_t*)(beg + size_in_words);
     std::fill(beg, end, 0);
+#endif
 }
 
 bool no_sd_card = false;
