 #include "temp_led_stuff.h"
 #include "ui.h"
 #include "daisysp.h"
@@ -11,6 +12,13 @@
 #include "OptionsManager.h"
 
 #define DSY_DTCMRAM_BSS __attribute__((section(".dtcmram_bss")))
+#ifdef NIDHOGG_HOST
+// Plain zeroed arrays on the host; the Daisy's memory sections don't exist.
+#undef DSY_DTCMRAM_BSS
+#define DSY_DTCMRAM_BSS
+#undef DSY_SDRAM_BSS
+#define DSY_SDRAM_BSS
