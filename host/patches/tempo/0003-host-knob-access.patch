+#ifdef NIDHOGG_HOST
+// For the host's board code. Knob access is called in the audio context; the
+// rest is read outside it, so a value can be a block old.
+float nidhogg_knob_value(int knob) { return ui.HostKnobValue(knob); }
+int nidhogg_knob_page(int knob) { return ui.HostKnobPage(knob); }
+bool nidhogg_menu_active() { return ui.menu_page_.IsActive(); }
+void nidhogg_turn(int knob, int turns) { ui.HostTurn(knob, turns); }
+// Only valid once the boot is done: everything is set up before.
+bool nidhogg_ready() { return !booting; }
+bool nidhogg_pitch_quantized() { return !options.pitch_shift_quantization; }
+// TEMPO state: engine (0 chromatic, 1 slice), input, monitor, recording,
+// tempo, clock mode, play type, latch, pattern, rest mode.
+void nidhogg_state(int* s)
+{
+    s[0] = int(fx.getEngine());
+    s[1] = int(fx.getInputSource());
+    s[2] = int(fx.getMonitorMode());
+    s[3] = fx.getRecording();
+    s[4] = cManager.getTempo();
+    s[5] = cManager.getClockMode();
+    s[6] = int(arpSeq.getPlayType());
+    s[7] = arpSeq.getLatch();
+    s[8] = arpSeq.getPattern();
+    s[9] = arpSeq.getRestMode();
+}
+// Levels for nidhogg's meters, 0-1, and MIDI clock ticks (24 a beat).
+void nidhogg_meters(float* in, float* out)
+{
+    *in  = fx.getVUSampleInput();
+    *out = fx.getVUSample();
+}
+uint32_t nidhogg_clock_ticks() { return nidhogg_ticks; }
+#endif
