@@ -63,7 +74,14 @@
 bool testLoad; //To make sure wavetables don't get loaded until later
 bool testSDLoaded;
 
+#ifdef NIDHOGG_HOST
+// SampleManager lays its samples out over the whole 64 MB SDRAM, starting past
+// the granular buffers, so it gets a block of its own.
+static uint8_t host_sdram[64 * 1024 * 1024];
+void *sample_ram_start = host_sdram;
+#else
 void *sample_ram_start = (void *)0xC0000000;
+#endif
 
