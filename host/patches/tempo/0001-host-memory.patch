@@ -204,11 +222,19 @@
 
 void ZeroSDRAM()
 {
+#ifdef NIDHOGG_HOST
+    // Zeroing the big buffers also maps their memory now, at boot, so audio
+    // never waits on the first touch of a page.
+    std::memset(granularBuffer, 0, sizeof(granularBuffer));
+    std::memset(frozenBuffer, 0, sizeof(frozenBuffer));
+    std::memset(host_sdram, 0, sizeof(host_sdram));
+#else
     uint32_t *beg, *end;
     size_t    size_in_words = (1024 * 1024 * 64) / sizeof(uint32_t);
     beg                     = (uint32_t*)0xc0000000;
     end                     = (uint32_t*)(beg + size_in_words);
     std::fill(beg, end, 0);
+#endif
 }
 
